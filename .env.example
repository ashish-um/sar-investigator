# Default: use the local Codex CLI's ChatGPT subscription login.
# Run `codex login`, choose Sign in with ChatGPT, and confirm `codex login status`.
LLM_PROVIDER=codex
LLM_MODEL=gpt-6.1-sol
CODEX_REASONING_EFFORT=low

# Optional native executable path when `codex` is not on PATH.
# On Windows, this must point to codex.exe rather than a .cmd/.bat wrapper.
# CODEX_CLI_PATH=C:/path/to/codex.exe
# CODEX_TIMEOUT_SECONDS=300

# Supported alternatives: groq, gemini, deepseek, cerebras, mistral, nvidia, llamacpp.
# When switching provider, update LLM_MODEL or clear it to use that provider's default.
# Add only the credential for the provider you select. Leave unused keys empty.
GROQ_API_KEY=
# GROQ_API_KEYS=  # Optional comma-separated Groq keys for rate-limit rotation.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=

# Local llama.cpp server; no API key required for this provider.
# LLM_PROVIDER=llamacpp
# LLM_MODEL=
# LLAMACPP_HOST=http://localhost:8080

# Relative to the project root. SQLite is included with Python.
DB_PATH=data/aml_synthetic.db
